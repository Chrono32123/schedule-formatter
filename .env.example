# Twitch API Configuration
# Get these from https://dev.twitch.tv/console

# Your Twitch Application Client ID (required)
VITE_TWITCH_CLIENT_ID=your_client_id_here

# Your Twitch Application Client Secret (required for server-side token generation)
# Keep this secret! Never commit the actual secret to version control
VITE_TWITCH_CLIENT_SECRET=your_client_secret_here

# OAuth Redirect URI (required for user authentication)
# For local development: http://localhost:5173/schedule-formatter/
# For production: https://yourdomain.com/schedule-formatter/
VITE_TWITCH_REDIRECT_URI=http://localhost:5173/schedule-formatter/
